@model List<Sportify.Models.Order>
@using Sportify.Confiuration.Enums
@{
    ViewData["Title"] = "Customer Orders - Admin";
}

<style>
    .orders-panel {
        background: #f8f8f8;
        min-height: 100vh;
        padding-top: 3rem;
        padding-bottom: 3rem;
    }

    .panel-subtitle {
        color: #CC0000;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .panel-title {
        font-size: 52px;
        font-weight: 800;
        color: #111;
    }

    .table-container {
        background: #fff;
        border-radius: 28px;
        padding: 35px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, .04);
        border: 1px solid #f0f0f0;
    }

    .status-badge {
        padding: 6px 14px;
        border-radius: 100px;
        font-size: 12px;
        font-weight: 700;
        display: inline-block;
    }

    .status-Pending { background: #fff4df; color: #ff9800; }
    .status-Confirmed { background: #e8f1ff; color: #0d6efd; }
    .status-Processing { background: #f0e8ff; color: #7c3aed; }
    .status-Shipped { background: #e8f1ff; color: #0d6efd; }
    .status-Delivered { background: #e9f9ef; color: #198754; }
    .status-Cancelled { background: #fde8e8; color: #DC1A2D; }
    .status-Refunded { background: #f5f5f5; color: #555; }

    .cancel-btn {
        background: #fde8e8;
        color: #DC1A2D;
        border: none;
        padding: 6px 16px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 13px;
        transition: .3s ease;
    }

    .cancel-btn:hover {
        background: #DC1A2D;
        color: #fff;
    }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
        color: #aaa;
    }
</style>

<section class="orders-panel">
    <div class="container">
        
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-5">
            <div>
                <span class="panel-subtitle">Store Sales</span>
                <h1 class="panel-title mt-2">Manage Orders</h1>
            </div>
            <div>
                <a asp-action="Dashboard" class="btn btn-danger px-4 py-2 rounded-3 me-2">Dashboard</a>
                <a asp-action="Manage" class="btn btn-dark px-4 py-2 rounded-3">Manage Store</a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="table-container">
            @if (Model == null || !Model.Any())
            {
                <div class="empty-state">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="mb-3">
                        <rect width="20" height="14" x="2" y="5" rx="2" />
                        <path d="M2 10h20" />
                    </svg>
                    <h3>No orders found</h3>
                    <p class="text-muted">Orders placed by customers will appear here.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Email</th>
                                <th>Products Purchased</th>
                                <th>Date</th>
                                <th>Payment</th>
                                <th>Status</th>
                                <th>Total</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                var customerName = order.User != null ? $"{order.User.FirstName} {order.User.LastName}" : "Unknown Customer";
                                var customerEmail = order.User?.Email ?? "—";
                                var statusClass = $"status-{order.Status}";

                                <tr>
                                    <td>
                                        <strong>
                                                Order ID: #SP@(order.OrderId.ToString("0000"))
                                        </strong>
                                    </td>
                                    <td>@customerName</td>
                                    <td>@customerEmail</td>
                                    <td>
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var item in order.OrderItems)
                                            {
                                                var product = item.ProductVariant?.Product;
                                                <div class="small">
                                                    @(product?.Name ?? "Product") (Size: @item.ProductVariant?.Size, Color: @item.ProductVariant?.Color) x @item.Quantity
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td>@order.CreatedAt.ToString("g")</td>
                                    <td>
                                        <span class="small">@order.PaymentMethod</span>
                                        @if (order.FastShiping)
                                        {
                                            <span class="badge bg-danger ms-1" style="font-size:10px">Express</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="status-badge @statusClass">@order.Status</span>
                                    </td>
                                    <td><strong>$@order.PaymentAmount.ToString("0.00")</strong></td>
                                    <td class="text-end">
                                        @if (order.Status == OrderStatus.Pending)
                                        {
                                            <form asp-action="CancelOrder" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@order.OrderId" />
                                                <button type="submit" class="cancel-btn" onclick="return confirm('Cancel order #SP@order.OrderId.ToString("D4")?')">
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>
</section>
