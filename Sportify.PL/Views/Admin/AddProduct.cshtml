@model Product
@using Sportify.Models

@{
    ViewData["Title"] = "Add Product";
    var brands = ViewBag.Brands as List<Brand> ?? new List<Brand>();
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
}

<section class="container py-5">
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible" role="alert">
            @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="text-uppercase text-muted fw-bold">Sportify Admin</span>
            <h1 class="fw-bold mt-2">Add Product</h1>
        </div>

        <a asp-controller="Admin" asp-action="Manage" class="btn btn-outline-dark">
            Back To Manage
        </a>
    </div>

    <form asp-controller="Admin"
          asp-action="AddProduct"
          method="post"
          enctype="multipart/form-data"
          class="row g-4">

        @Html.AntiForgeryToken()

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4">Product Information</h4>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Product Name</label>
                        <input asp-for="Name" class="form-control form-control-lg" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="BrandID" class="form-label fw-semibold">Brand</label>
                            <select asp-for="BrandID" class="form-select form-select-lg" required>
                                <option value="">Select brand</option>
                                @foreach (var brand in brands)
                                {
                                    <option value="@brand.BrandID">@brand.Name</option>
                                }
                            </select>
                            <span asp-validation-for="BrandID" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoryID" class="form-label fw-semibold">Category</label>
                            <select asp-for="CategoryID" class="form-select form-select-lg" required>
                                <option value="">Select category</option>
                                @foreach (var category in categories)
                                {
                                    <option value="@category.CategoryID">@category.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryID" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                        <h4 class="fw-bold mb-0">Product Variants</h4>

                        <button type="button" class="btn btn-outline-dark" onclick="addVariantRow()">
                            Add Variant
                        </button>
                    </div>

                    <div id="variantsWrapper">
                        <div class="variant-row border rounded-3 p-3 mb-3">
                            <input type="hidden" name="variantIndices" value="0" />
                            <div class="row g-3">
                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">Color</label>
                                    <input type="text" name="variantColors" class="form-control" required />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">Size</label>
                                    <input type="text" name="variantSizes" class="form-control" required />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">Price</label>
                                    <input type="number" name="variantPrices" step="0.01" min="0" class="form-control" required />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">Stock</label>
                                    <input type="number" name="variantStockQuantities" min="0" class="form-control" required />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">SKU</label>
                                    <input type="text" name="variantSkus" class="form-control" required />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label fw-semibold">Images</label>
                                    <input type="file"
                                           name="variantImages_0"
                                           class="form-control"
                                           accept="image/png,image/jpeg,image/webp,image/gif"
                                           multiple />
                                </div>
                            </div>
                        </div>
                    </div>

                    <p class="text-muted mb-0">
                        Add one row for each color/size. Each variant can have multiple photos.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4">Main Product Images</h4>

                    <input type="file"
                           id="productImages"
                           name="productImages"
                           class="form-control"
                           accept="image/png,image/jpeg,image/webp,image/gif"
                           multiple />

                    <div id="imagePreviewContainer" class="row g-2 mt-3">
                        <div class="col-12 text-center text-muted border rounded p-4">
                            No main images selected
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <button type="submit" class="btn btn-dark w-100 py-3 fw-bold">
                        Save Product
                    </button>

                    <a asp-controller="Admin"
                       asp-action="Manage"
                       class="btn btn-outline-secondary w-100 py-3 mt-2">
                        Cancel
                    </a>
                </div>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        let variantIndex = 1;

        function addVariantRow() {
            const wrapper = document.getElementById("variantsWrapper");

            const row = document.createElement("div");
            row.className = "variant-row border rounded-3 p-3 mb-3";

            row.innerHTML = `
                <input type="hidden" name="variantIndices" value="${variantIndex}" />
                <div class="row g-3">
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Color</label>
                        <input type="text" name="variantColors" class="form-control" required />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Size</label>
                        <input type="text" name="variantSizes" class="form-control" required />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Price</label>
                        <input type="number" name="variantPrices" step="0.01" min="0" class="form-control" required />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Stock</label>
                        <input type="number" name="variantStockQuantities" min="0" class="form-control" required />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-semibold">SKU</label>
                        <input type="text" name="variantSkus" class="form-control" required />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Images</label>
                        <input type="file"
                               name="variantImages_${variantIndex}"
                               class="form-control"
                               accept="image/png,image/jpeg,image/webp,image/gif"
                               multiple />
                    </div>

                    <div class="col-12">
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                onclick="this.closest('.variant-row').remove()">
                            Remove Variant
                        </button>
                    </div>
                </div>
            `;

            wrapper.appendChild(row);
            variantIndex++;
        }

        document.addEventListener("DOMContentLoaded", function () {
            const imagesInput = document.getElementById("productImages");
            const previewContainer = document.getElementById("imagePreviewContainer");

            if (imagesInput && previewContainer) {
                imagesInput.addEventListener("change", function () {
                    previewContainer.innerHTML = "";
                    const files = this.files;

                    if (!files || files.length === 0) {
                        previewContainer.innerHTML = `
                            <div class="col-12 text-center text-muted border rounded p-4">
                                No main images selected
                            </div>
                        `;
                        return;
                    }

                    Array.from(files).forEach(file => {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            const col = document.createElement("div");
                            col.className = "col-4 position-relative";
                            col.innerHTML = `
                                <img src="${e.target.result}" class="img-fluid rounded border shadow-sm" style="height: 100px; width: 100%; object-fit: cover;" />
                            `;
                            previewContainer.appendChild(col);
                        };
                        reader.readAsDataURL(file);
                    });
                });
            }
        });
    </script>
}