@model Category
@using Sportify.Models
@{
    var parentCategories = ViewBag.ParentCategories as List<Category> ?? new();
}

<section class="container py-5">
    <h1 class="fw-bold mb-4">Edit Category</h1>

    <form asp-action="EditCategory" asp-route-id="@Model.CategoryID" method="post" class="row g-3">
        @Html.AntiForgeryToken()
        <input asp-for="CategoryID" type="hidden" />

        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" required />
        </div>

        <div class="col-md-6">
            <label asp-for="ParentCategoryID" class="form-label">Parent Category</label>
            <select asp-for="ParentCategoryID" class="form-select">
                <option value="">None</option>
                @foreach (var category in parentCategories)
                {
                    <option value="@category.CategoryID">@category.Name</option>
                }
            </select>
        </div>

        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-dark">Save Changes</button>
            <a asp-action="Manage" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</section>