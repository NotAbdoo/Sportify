@model Brand

<section class="container py-5">
    <h1 class="fw-bold mb-4">Edit Brand</h1>

    <form asp-action="EditBrand" asp-route-id="@Model.BrandID" method="post" enctype="multipart/form-data" class="row g-3">
        @Html.AntiForgeryToken()
        <input asp-for="BrandID" type="hidden" />

        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" required />
        </div>

        <div class="col-md-6">
            <label class="form-label">Replace Logo</label>
            <input type="file" name="logoImage" class="form-control" accept="image/png,image/jpeg,image/svg+xml" />
        </div>

        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        </div>

        <div class="col-12">
            <img src="@Model.LogoURL" width="120" class="rounded border mb-3" />
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-dark">Save Changes</button>
            <a asp-action="Manage" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</section>