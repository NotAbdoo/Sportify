@model List<Sportify.Models.Product>
@using System.Linq

@{
    ViewData["Title"] = (ViewBag.CategoryName ?? "Kids") + " Collection - Sportify";
}

<style>
    /* PAGE HEADER */
    .page-title {
        color: #111;
        font-weight: 800;
        letter-spacing: 2px;
        font-size: 42px;
    }

    /* PRODUCT CARD */
    .product-item {
        background: #fff;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid #f1f1f1;
        transition: 0.35s ease;
        height: 100%;
    }

        .product-item:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
            border-color: #CC0000; /* Primary Brand Color */
        }

    /* IMAGE CONTAINER */
    .image-holder {
        position: relative;
        overflow: hidden;
        background: #f8f8f8;
        padding-top: 20px;
    }

    .product-image {
        width: 100%;
        height: 240px;
        object-fit: contain;
        transition: 0.4s ease;
    }

    .product-item:hover .product-image {
        transform: scale(1.08);
    }

    /* WISHLIST BUTTON */
    .btn-wishlist {
        position: absolute;
        top: 15px;
        right: 15px;
        width: 40px;
        height: 40px;
        background: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #111;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        transition: 0.3s ease;
        z-index: 10;
    }

        .btn-wishlist:hover {
            background: #DC1A2D; /* Red for wishlist */
            color: #fff;
            transform: scale(1.1);
        }

    /* CONTENT AREA */
    .product-content {
        padding: 20px;
        text-align: center;
        background: #fff;
        position: relative;
        z-index: 2;
    }

    .element-title a {
        color: #111;
        font-weight: 700;
        text-decoration: none;
        transition: 0.3s ease;
    }

        .element-title a:hover {
            color: #CC0000; /* Primary Brand Color */
        }

    /* PRICE & ADD TO CART */
    .price-cart-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid #eee;
    }

    .product-price {
        font-weight: 800;
        color: #CC0000; /* Primary Brand Color */
        font-size: 18px;
    }

    .add-cart-text {
        font-size: 14px;
        font-weight: 700;
        color: #111;
        text-transform: uppercase;
        transition: 0.3s ease;
    }

        .add-cart-text:hover {
            color: #CC0000;
        }

    /* MOBILE ADJUSTMENTS */
    @@media (max-width: 768px) {
        .product-image {
            height: 200px;
        }

        .page-title {
            font-size: 32px;
        }
    }
</style>

<section class="py-5 bg-light">
    <div class="container text-center">
        <h1 class="page-title text-uppercase mt-4">@(ViewBag.CategoryName ?? "Kids")</h1>
        <p class="text-muted mt-2">@(ViewBag.CategoryDescription ?? "Explore our exclusive Kids' collection.")</p>
        <p class="text-muted"><strong>@(Model?.Count ?? 0)</strong> product(s) found</p>
    </div>
</section>

<section class="product-grid py-5">
    <div class="container">

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="none" stroke="#ccc" stroke-width="1.5" viewBox="0 0 24 24" class="mb-3">
                    <path d="M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"></path>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
                <h4 class="text-muted">No products found in this category yet.</h4>
                <a asp-controller="Products" asp-action="Index" class="btn btn-dark mt-3 px-4 py-2">Browse All Products</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var product in Model)
                {
                    var firstVariant = product.ProductVariants?.FirstOrDefault();

                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="product-item">
                            <div class="image-holder">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.ProductID">
                                    <img src="@product.ImageURL.GetFirstImageUrl()" alt="@product.Name" class="product-image">
                                </a>

                                <form asp-controller="Wishlist" asp-action="Add" method="post" style="position:absolute;top:15px;right:15px;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.ProductID" />
                                    <button type="submit" class="btn-wishlist" title="Add to Wishlist">
                                        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                        </svg>
                                    </button>
                                </form>
                            </div>

                            <div class="product-content">
                                <p class="text-muted mb-1" style="font-size:12px;letter-spacing:1px;text-transform:uppercase;">@product.Category?.Name</p>
                                <h5 class="element-title mb-0">
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@product.ProductID">@product.Name</a>
                                </h5>
                                <div class="price-cart-wrapper">
                                    <span class="product-price">
                                        @(firstVariant != null ? $"${firstVariant.Price:F2}" : "—")
                                    </span>
                                    @if (firstVariant != null)
                                    {
                                        <form asp-controller="Cart" asp-action="Add" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productVariantId" value="@firstVariant.ProductVariantId" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <button type="submit" class="add-cart-text btn btn-link text-decoration-none p-0">Add to Cart +</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</section>