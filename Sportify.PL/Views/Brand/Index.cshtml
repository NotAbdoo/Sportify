@model List<Brand>

@{
    ViewData["Title"] = "Brands - Sportify";
}

<style>
    .brands-page {
        background: var(--surface-soft);
        min-height: 100vh;
        padding: 90px 0;
    }

    .page-subtitle {
        color: #CC0000;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-size: 14px;
    }

    .page-title {
        font-size: 56px;
        font-weight: 800;
        color: var(--heading-color);
    }

    .brand-card {
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        padding: 35px;
        height: 100%;
        text-align: center;
        transition: .3s ease;
    }

        .brand-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 60px rgba(0, 0, 0, .08);
            border-color: #CC0000;
        }

    .brand-logo-wrapper {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: var(--surface-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 25px;
    }

    .brand-logo {
        max-width: 90px;
        max-height: 90px;
        object-fit: contain;
    }

    .brand-name {
        font-size: 24px;
        font-weight: 800;
        color: var(--heading-color);
    }

    .brand-description {
        color: var(--muted-text);
        margin-top: 12px;
        line-height: 1.7;
    }

    .brand-products-count {
        color: #CC0000;
        font-weight: 700;
        margin-top: 16px;
        display: block;
    }

    .shop-brand-btn {
        display: inline-block;
        margin-top: 24px;
        background: #CC0000;
        color: #fff;
        padding: 12px 28px;
        border-radius: 14px;
        text-decoration: none;
        font-weight: 700;
        transition: .3s ease;
    }

        .shop-brand-btn:hover {
            background: #2a1e5c;
            color: #fff;
            transform: translateY(-3px);
        }

    .empty-state {
        background: var(--surface-color);
        border-radius: 24px;
        padding: 50px;
        text-align: center;
        border: 1px solid var(--border-color);
    }
</style>

<section class="brands-page">
    <div class="container">
        <div class="text-center mb-5">
            <span class="page-subtitle">WORLD CLASS</span>
            <h1 class="page-title mt-3">All Brands</h1>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">
                <h3>No brands found</h3>
                <p>Add brands from the admin panel first.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var brand in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="brand-card">
                            <div class="brand-logo-wrapper">
                                <img src="@brand.LogoURL"
                                     class="brand-logo"
                                     alt="@brand.Name">
                            </div>

                            <h3 class="brand-name">@brand.Name</h3>

                            <p class="brand-description">
                                @brand.Description
                            </p>

                            <span class="brand-products-count">
                                @(brand.Products?.Count ?? 0) Products
                            </span>

                            <a asp-controller="Products"
                               asp-action="ByBrand"
                               asp-route-id="@brand.BrandID"
                               class="shop-brand-btn">
                                Shop Brand
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>