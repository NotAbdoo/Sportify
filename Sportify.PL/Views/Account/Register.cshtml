@{
    ViewData["Title"] = "Register - Sportify";
}

<section class="py-5 bg-light min-vh-100 d-flex align-items-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="bg-white p-5 rounded-4 shadow-sm">
                    <h1 class="fw-bold mb-2">Create Account</h1>
                    <p class="text-muted mb-4">Join Sportify and start shopping.</p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form asp-controller="Account" asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">First Name</label>
                                <input type="text" name="firstName" class="form-control form-control-lg" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Last Name</label>
                                <input type="text" name="lastName" class="form-control form-control-lg" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Email</label>
                                <input type="email" name="email" class="form-control form-control-lg" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Phone</label>
                                <input type="text" name="phone" class="form-control form-control-lg">
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Address</label>
                                <input type="text" name="address" class="form-control form-control-lg">
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Account Type</label>
                                <select name="role" class="form-control form-control-lg" required>
                                    <option value="Customer" selected>🛍️ Customer — Shop for sports gear</option>
                                    <option value="GymOwner">🏋️ Gym Owner — List my gym on Sportify</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Password</label>
                                <input type="password" name="password" class="form-control form-control-lg" required>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn text-white w-100 py-3 fw-bold" style="background:#CC0000;">
                                    Register
                                </button>
                            </div>
                        </div>
                    </form>

                    <p class="text-center mt-4 mb-0">
                        Already have an account?
                        <a asp-controller="Account" asp-action="Login">Login</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>