@model User

@{
    ViewData["Title"] = "My Profile";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="text-uppercase fw-bold text-muted">Sportify Account</span>
            <h1 class="fw-bold mt-2">My Profile</h1>
        </div>

        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger">
            Logout
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <div class="rounded-circle bg-dark text-white d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:96px;height:96px;font-size:36px;font-weight:700;">
                        @Model.FirstName.Substring(0, 1)@Model.LastName.Substring(0, 1)
                    </div>

                    <h3 class="fw-bold mb-1">@Model.FirstName @Model.LastName</h3>
                    <p class="text-muted mb-2">@Model.Email</p>

                    <span class="badge bg-dark px-3 py-2">@Model.Role</span>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4">Account Details</h4>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted small">First Name</label>
                            <div class="fw-semibold">@Model.FirstName</div>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted small">Last Name</label>
                            <div class="fw-semibold">@Model.LastName</div>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted small">Email</label>
                            <div class="fw-semibold">@Model.Email</div>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted small">Phone</label>
                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.Phone) ? "-" : Model.Phone)</div>
                        </div>

                        <div class="col-12">
                            <label class="text-muted small">Address</label>
                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.Address) ? "-" : Model.Address)</div>
                        </div>

                        <div class="col-md-6">
                            <label class="text-muted small">Joined</label>
                            <div class="fw-semibold">@Model.CreatedAt.ToString("dd MMM yyyy")</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">Quick Links</h4>

                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-dark">
                            My Cart
                        </a>

                        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-dark">
                            Continue Shopping
                        </a>

                        @if (Model.Role == "Admin")
                        {
                            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-primary">
                                Admin Dashboard
                            </a>

                            <a asp-controller="Admin" asp-action="Manage" class="btn btn-outline-primary">
                                Manage Store
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>