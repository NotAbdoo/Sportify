@model Sportify.Models.GymClass

@{
    ViewData["Title"] = "Add Class - Sportify";
    int gymId = ViewBag.GymId;
    string gymName = ViewBag.GymName ?? "Your Gym";
}

<style>
    .form-header { background: #0a0a0a; padding:48px 0 36px; border-bottom:3px solid #CC0000; }
    .form-header h1 { color:#fff; font-weight:800; }
    .form-header p { color:rgba(255,255,255,.7); }
    .form-card { border:none; border-radius:20px; box-shadow:0 8px 40px rgba(0,0,0,.1); padding:40px; }
    .form-control, .form-select { border-radius:10px; border:1.5px solid #e5e7eb; padding:12px 16px; transition:border-color .2s; }
    .form-control:focus { border-color:#CC0000; box-shadow:0 0 0 3px rgba(204,0,0,.1); }
    .form-label { font-weight:600; color:#2d3748; }
    .submit-btn { background:#CC0000; color:#fff; border:none; border-radius:12px; padding:14px 32px; font-weight:700; width:100%; transition:.2s; }
    .submit-btn:hover { background:#a80000; transform:translateY(-2px); box-shadow:0 8px 20px rgba(204,0,0,.4); }
    .preview-grid { display:flex; flex-wrap:wrap; gap:10px; margin-top:10px; }
    .preview-img { width:100px; height:80px; object-fit:cover; border-radius:8px; border:2px solid #e5e7eb; }
    .info-tip { background:#fff5f5; border-left:4px solid #CC0000; border-radius:8px; padding:12px 16px; font-size:.88rem; color:#3a3a3a; }
</style>

<div class="form-header">
    <div class="container">
        <a asp-controller="Gym" asp-action="ManageProfile" asp-route-gymId="@gymId" class="text-white opacity-75 text-decoration-none">← Back to @gymName</a>
        <h1 class="mt-2">Add New Class</h1>
        <p class="mb-0">Add a class to your gym's profile — you can upload multiple photos</p>
    </div>
</div>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="form-card">

                    <div class="info-tip mb-4">
                        <strong>Tip:</strong> Upload multiple photos to show your class in action — this increases member interest significantly!
                    </div>

                    <form asp-controller="Gym" asp-action="AddClass" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="GymAdId" value="@gymId" />

                        <div class="mb-4">
                            <label class="form-label">Class Name <span class="text-danger">*</span></label>
                            <input type="text" name="ClassName" class="form-control" placeholder="e.g. CrossFit, Yoga, Boxing…" required maxlength="100" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Description <span class="text-danger">*</span></label>
                            <textarea name="Description" class="form-control" rows="4"
                                      placeholder="What does this class involve? Who is it for? What equipment is needed?" required></textarea>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label">Duration</label>
                                <input type="text" name="Duration" class="form-control" placeholder="e.g. 60 min, 90 min" maxlength="50" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Price / Membership</label>
                                <input type="text" name="Price" class="form-control" placeholder="e.g. 300 EGP/month, Free" maxlength="100" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Class Photos <span class="text-muted">(select multiple, max 5MB each)</span></label>
                            <input type="file" name="classImages" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif"
                                   multiple onchange="previewImages(this)" />
                            <div class="preview-grid" id="previewGrid"></div>
                        </div>

                        <button type="submit" class="submit-btn">Add Class</button>

                        <a asp-controller="Gym" asp-action="ManageProfile" asp-route-gymId="@gymId"
                           class="btn btn-outline-secondary w-100 mt-3 rounded-3 py-3 fw-semibold">
                            Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function previewImages(input) {
        const grid = document.getElementById('previewGrid');
        grid.innerHTML = '';
        if (input.files) {
            [...input.files].forEach(file => {
                const reader = new FileReader();
                reader.onload = e => {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.className = 'preview-img';
                    grid.appendChild(img);
                };
                reader.readAsDataURL(file);
            });
        }
    }
</script>
