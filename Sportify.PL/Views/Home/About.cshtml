@{
    ViewData["Title"] = "About - Sportify";
}

<section class="py-5 bg-light">
    <div class="container py-5">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="text-uppercase fw-bold" style="color:#CC0000; letter-spacing:2px;">
                    About Sportify
                </span>

                <h1 class="fw-bold mt-3 mb-4" style="font-size:56px;">
                    Built For Every Athlete
                </h1>

                <p class="text-muted fs-5 lh-lg">
                    Sportify is your destination for sportswear, footwear, and training essentials.
                    We bring together trusted brands, modern designs, and performance-ready products
                    to help every athlete move better.
                </p>

                <p class="text-muted fs-5 lh-lg">
                    Whether you train at the gym, play football, run daily, or just love comfortable
                    sports fashion, Sportify helps you find the right gear easily.
                </p>

                <a asp-controller="Products" asp-action="Index" class="btn btn-dark px-4 py-3 mt-3">
                    Explore Products
                </a>
            </div>

            <div class="col-lg-6">
                <img src="https://images.unsplash.com/photo-1517836357463-d25dfeac3438?q=80&w=1200&auto=format&fit=crop"
                     class="img-fluid rounded-4 shadow"
                     alt="Sportify athletes">
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="p-4 bg-light rounded-4 h-100">
                    <h3 class="fw-bold">Quality Gear</h3>
                    <p class="text-muted mb-0">
                        Products selected for comfort, durability, and performance.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-4 bg-light rounded-4 h-100">
                    <h3 class="fw-bold">Top Brands</h3>
                    <p class="text-muted mb-0">
                        Shop sports products from trusted global and local brands.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-4 bg-light rounded-4 h-100">
                    <h3 class="fw-bold">Easy Shopping</h3>
                    <p class="text-muted mb-0">
                        Simple browsing, wishlist, cart, and smooth product discovery.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>