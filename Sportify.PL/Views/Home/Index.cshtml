@using System.Linq
@model Sportify.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home - Sportify";
}
<style>
    /* UTILITY SPACING */
    .py-6 {
        padding: 120px 0;
    }

    /* HERO SECTION */
    .hero-section {
        background: var(--surface-soft);
    }

    .hero-badge {
        background: #CC0000; /* Primary Brand Color */
        color: #fff;
        padding: 10px 22px;
        border-radius: 100px;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    .hero-title {
        font-size: clamp(55px, 8vw, 110px);
        line-height: 0.95;
        font-weight: 800;
        color: var(--heading-color);
    }

    .hero-description {
        font-size: 20px;
        color: var(--muted-text);
        max-width: 620px;
        line-height: 1.8;
    }

    .hero-btn-primary {
        background: #CC0000; /* Primary Brand Color */
        color: #fff;
        border: none;
        border-radius: 14px;
        font-weight: 600;
        transition: .3s ease;
    }

        .hero-btn-primary:hover {
            background: #CC0000;
            color: #fff;
            transform: translateY(-3px);
        }

    .hero-btn-outline {
        border: 2px solid var(--text-color);
        color: var(--text-color);
        border-radius: 14px;
        font-weight: 600;
        transition: .3s ease;
    }

        .hero-btn-outline:hover {
            background: var(--text-color);
            color: var(--bg-color);
        }

    .hero-image {
        width: 100%;
        height: 100vh;
        object-fit: cover;
    }

    .hero-video {
        width: 550px; /* Adjust as needed */
        height: auto;
        border-radius: 12px;
    }

    .hero-stats h2 {
        font-size: 42px;
        font-weight: 700;
        color: var(--heading-color);
    }

    .hero-stats span {
        color: var(--muted-text);
    }

    /* SECTION HEADERS */
    .section-subtitle {
        color: #CC0000; /* Primary Brand Color */
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-size: 14px;
    }

    .section-title {
        font-size: 56px;
        font-weight: 700;
        color: var(--heading-color);
    }

    /* CIRCLES (SPORTS & BRANDS) */
    .sport-circle,
    .brand-circle {
        width: 190px;
        height: 190px;
        background: var(--surface-color);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        transition: .35s ease;
        border: 1px solid var(--border-color);
    }

    .sport-icon,
    .brand-logo {
        width: 90px;
        transition: .35s ease;
    }

    .sport-card:hover .sport-circle,
    .brand-circle:hover {
        transform: translateY(-10px);
        box-shadow: 0 25px 60px rgba(0, 0, 0, .08);
        border-color: #CC0000; /* Primary Brand Color */
    }

        .sport-card:hover .sport-icon,
        .brand-circle:hover .brand-logo {
            transform: scale(1.1);
        }

    .sport-title,
    .brand-name {
        margin-top: 24px;
        text-align: center;
        color: var(--text-color);
        font-weight: 600;
    }

    /* PRODUCT CARDS */
    .product-card {
        background: var(--surface-color);
        border-radius: 28px;
        overflow: hidden;
        transition: .35s ease;
        border: 1px solid var(--border-color);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 30px 70px rgba(0, 0, 0, .08);
        }

    .product-image-wrapper {
        position: relative;
        overflow: hidden;
    }

    .product-image {
        width: 100%;
        height: 340px;
        object-fit: cover;
        transition: .35s ease;
    }

    .product-card:hover .product-image {
        transform: scale(1.08);
    }

    .product-badge {
        position: absolute;
        top: 18px;
        left: 18px;
        background: #CC0000; /* Primary Brand Color */
        color: #fff;
        padding: 8px 18px;
        border-radius: 100px;
        font-size: 12px;
        font-weight: 700;
    }

    .product-content {
        padding: 28px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .product-category {
        color: #999;
        text-transform: uppercase;
        font-size: 13px;
        letter-spacing: 1px;
    }

    .product-title {
        margin-top: 10px;
        font-size: 24px;
        color: var(--heading-color);
        font-weight: 600;
    }

    .product-price {
        font-size: 24px;
        font-weight: 700;
        color: #CC0000; /* Primary Brand Color */
    }

    .add-cart-btn {
        width: 50px;
        height: 50px;
        border: none;
        border-radius: 50%;
        background: var(--text-color);
        color: var(--bg-color);
        font-size: 24px;
        transition: .3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .add-cart-btn:hover {
            background: #CC0000; /* Primary Brand Color */
            transform: rotate(90deg);
        }

    .view-all-link {
        color: var(--text-color);
        font-weight: 600;
        text-decoration: none;
        transition: .3s ease;
    }

        .view-all-link:hover {
            color: #CC0000;
        }

    /* PROMO BANNER */
    .promo-wrapper {
        background: #111;
        border-radius: 40px;
        padding: 70px;
        overflow: hidden;
    }

    .promo-subtitle {
        color: #CC0000; /* Primary Brand Color */
        font-weight: 700;
        letter-spacing: 2px;
    }

    .promo-title {
        color: #fff;
        font-size: 72px;
        font-weight: 800;
        line-height: 1;
    }

    .promo-text {
        color: #bbb;
        font-size: 20px;
    }

    .promo-image {
        border-radius: 28px;
        max-height: 500px;
        object-fit: cover;
    }

    /* MOBILE ADJUSTMENTS */
    @@media (max-width: 991px) {
        .hero-image {
            height: 60vh;
        }

        .hero-title {
            font-size: 62px;
        }

        .section-title {
            font-size: 42px;
        }

        .promo-title {
            font-size: 48px;
        }

        .promo-wrapper {
            padding: 40px;
        }

        .sport-circle, .brand-circle {
            width: 140px;
            height: 140px;
        }
    }
</style>

<section class="hero-section position-relative overflow-hidden">
    <div class="container-fluid px-0">
        <div class="row g-0 align-items-center min-vh-100">
            <div class="col-lg-6 px-5 px-lg-6 py-5 order-2 order-lg-1">
                <span class="hero-badge">NEW COLLECTION 2026</span>
                <h1 class="hero-title mt-4">LEVEL UP<br>YOUR GAME</h1>
                <p class="hero-description mt-4">
                    Discover premium sportswear, performance footwear,
                    and elite training essentials designed for athletes
                    who never settle.
                </p>
                <div class="d-flex flex-wrap gap-3 mt-5">
                    <a asp-controller="Products" asp-action="Index" class="btn hero-btn-primary px-5 py-3 text-decoration-none">
                        Shop Now
                    </a>
                    <a href="#categories" class="btn hero-btn-outline px-5 py-3 text-decoration-none">
                        Explore Categories
                    </a>
                </div>
                <div class="hero-stats row mt-5 pt-4">
                    <div class="col-4">
                        <h2>@Model.ProductCount</h2>
                        <span>Products</span>
                    </div>
                    <div class="col-4">
                        <h2>@Model.BrandCount</h2>
                        <span>Brands</span>
                    </div>
                    <div class="col-4">
                        <h2>@Model.UserCount</h2>
                        <span>Happy Clients</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 order-1 order-lg-2">
                <div class="d-flex justify-content-end">
                    <video class="hero-video" autoplay muted loop playsinline>
                        <source src="~/videos/wcvideo.mp4" type="video/mp4">
                    </video>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="categories" class="py-6 bg-white">
    <div class="container">
        <div class="section-header text-center mb-5">
            <span class="section-subtitle">TOP CATEGORIES</span>
            <h2 class="section-title">Shop By Sport</h2>
        </div>
        <div class="row justify-content-center g-4">

            @if (Model.SportCategories == null || !Model.SportCategories.Any())
            {
                <div class="col-12 text-center py-5 text-muted">
                    <p>No sport categories found. Add them from the admin panel.</p>
                </div>
            }
            else
            {
                @foreach (var sport in Model.SportCategories)
                {
                    <div class="col-6 col-md-3">
                        <a asp-controller="Products"
                           asp-action="Index"
                           asp-route-categoryId="@sport.CategoryID"
                           class="sport-card text-decoration-none">
                            <div class="sport-circle">
                                <img src="@GetSportIcon(sport.Name)" alt="@sport.Name" class="sport-icon">
                            </div>
                            <h5 class="sport-title">@sport.Name</h5>
                        </a>
                    </div>
                }
            }

        </div>
    </div>
</section>

<section class="py-6 bg-light">
    <div class="container">
        <div class="section-header text-center mb-5">
            <span class="section-subtitle">WORLD CLASS</span>
            <h2 class="section-title">Featured Brands</h2>
        </div>
        <div class="row justify-content-center g-4">
            @if (Model.FeaturedBrands != null)
            {
                @foreach (var brand in Model.FeaturedBrands)
                {
                    <div class="col-6 col-md-4 col-lg-2">
                        <a asp-controller="Products"
                           asp-action="ByBrand"
                           asp-route-id="@brand.BrandID"
                           class="text-decoration-none">

                            <div class="brand-circle mx-auto">
                                <img src="@brand.LogoURL"
                                     class="brand-logo"
                                     alt="@brand.Name">
                            </div>

                            <h5 class="brand-name text-center mt-3">@brand.Name</h5>
                        </a>
                    </div>
                }
            }
        </div>
    </div>
</section>

<section class="py-6 bg-white">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap mb-5">
            <div>
                <span class="section-subtitle">TRENDING NOW</span>
                <h2 class="section-title mb-0">Featured Products</h2>
            </div>
            <a asp-controller="Products"
               class="view-all-link">
                View All Products →
            </a>
        </div>

        <div class="row g-4">
            @if (Model.FeaturedProducts != null)
            {
                @foreach (var product in Model.FeaturedProducts)
                {
                    var firstVariant = product.ProductVariants?.FirstOrDefault();

                    <div class="col-md-6 col-lg-3">
                        <div class="product-card">
                            <div class="product-image-wrapper">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.ProductID">
                                    <img src="@product.ImageURL.GetFirstImageUrl()"
                                         class="img-fluid product-image"
                                         alt="@product.Name">
                                </a>

                                <span class="product-badge">NEW</span>
                            </div>

                            <div class="product-content">
                                <span class="product-category">
                                    @product.Category?.Name
                                </span>

                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.ProductID"
                                   class="text-decoration-none">
                                    <h5 class="product-title">@product.Name</h5>
                                </a>

                                <div class="mt-auto pt-3">
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <span class="product-price">
                                            @(firstVariant != null ? $"${firstVariant.Price}" : "No price")
                                        </span>

                                        @if (firstVariant != null)
                                        {
                                            <form asp-controller="Cart" asp-action="Add" method="post">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="productVariantId"
                                                       value="@firstVariant.ProductVariantId" />

                                                <input type="hidden"
                                                       name="quantity"
                                                       value="1" />

                                                <button type="submit" class="add-cart-btn">+</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<section class="promo-banner py-6" >
    <div class="container">
        <div class="promo-wrapper">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <span class="promo-subtitle">LIMITED OFFER</span>
                    <h2 class="promo-title mt-3">GET 40% OFF<br>ON NEW ARRIVALS</h2>
                    <p class="promo-text mt-4">
                        Upgrade your performance with our latest collections.
                    </p>
                    <a asp-controller="Products" asp-action="Index" class="btn hero-btn-primary mt-4 px-5 py-3 text-decoration-none">
                        Start Shopping
                    </a>
                </div>
                <div class="col-lg-6 text-center mt-5 mt-lg-0">
                    <img src="https://images.unsplash.com/photo-1514996937319-344454492b37?q=80&w=1200&auto=format&fit=crop" class="img-fluid promo-image" alt="Promo">
                </div>
            </div>
            <section id="faq"></section>
        </div>
    </div>
</section>

<section class="faq-section py-5">
    <div class="container">
        <div class="text-center mb-5">
            <span class="text-danger fw-bold text-uppercase">Help Center</span>
            <h2 class="fw-bold mt-2">Frequently Asked Questions</h2>
            <p class="text-muted">Quick answers about shopping with Sportify.</p>
        </div>

        <div class="accordion" id="faqAccordion">

            <div class="accordion-item mb-3 border rounded">
                <h2 class="accordion-header" id="faqOne">
                    <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapseOne">
                        How can I place an order?
                    </button>
                </h2>
                <div id="faqCollapseOne" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Choose your product, select the size/color if available, add it to your cart, then complete checkout.
                    </div>
                </div>
            </div>

            <div class="accordion-item mb-3 border rounded">
                <h2 class="accordion-header" id="faqTwo">
                    <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapseTwo">
                        Can I return or exchange a product?
                    </button>
                </h2>
                <div id="faqCollapseTwo" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Yes, you can request a return or exchange if the product is unused and still in its original condition.
                    </div>
                </div>
            </div>

            <div class="accordion-item mb-3 border rounded">
                <h2 class="accordion-header" id="faqThree">
                    <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapseThree">
                        How long does delivery take?
                    </button>
                </h2>
                <div id="faqCollapseThree" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Delivery usually takes 2 to 5 business days depending on your city and shipping address.
                    </div>
                </div>
            </div>

            <div class="accordion-item mb-3 border rounded">
                <h2 class="accordion-header" id="faqFour">
                    <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapseFour">
                        What payment methods are available?
                    </button>
                </h2>
                <div id="faqCollapseFour" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        You can pay using cash on delivery or any available online payment method configured in the store.
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@functions {
    private string GetSportIcon(string sportName)
    {
        return sportName.ToLower() switch
        {
            "football"   => "https://cdn-icons-png.flaticon.com/512/53/53283.png",
            "basketball" => "https://cdn-icons-png.flaticon.com/512/889/889455.png",
            "padel"      => "https://www.svgrepo.com/show/315897/tennis-ball.svg",
            "tennis"     => "https://www.svgrepo.com/show/315897/tennis-ball.svg",
            "gym"        => "https://www.svgrepo.com/show/461254/dumbbell.svg",
            "running"    => "https://cdn-icons-png.flaticon.com/512/384/384276.png",
            _            => "https://cdn-icons-png.flaticon.com/512/857/857455.png"
        };
    }
}