@model List<WishlistItem>

@{
    ViewData["Title"] = "My Wishlist";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="text-uppercase text-muted fw-bold">Sportify</span>
            <h1 class="fw-bold mt-2">My Wishlist</h1>
        </div>

        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-dark">
            Continue Shopping
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-light rounded">
            <h3 class="fw-bold">Your wishlist is empty</h3>
            <p class="text-muted">Save your favorite products here.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-dark">
                Shop Now
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var product = item.Product;
                var firstVariant = product.ProductVariants?.FirstOrDefault();

                <div class="col-md-6 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm">
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.ProductID">
                            <img src="@product.ImageURL.GetFirstImageUrl()"
                                 class="card-img-top"
                                 alt="@product.Name"
                                 style="height:260px;object-fit:cover;" />
                        </a>

                        <div class="card-body d-flex flex-column">
                            <span class="text-muted small text-uppercase">
                                @product.Category?.Name
                            </span>

                            <h5 class="fw-bold mt-2">@product.Name</h5>

                            <p class="text-muted mb-2">@product.Brand?.Name</p>

                            <div class="fw-bold mb-3">
                                @(firstVariant == null ? "No price" : firstVariant.Price.ToString("0.00"))
                            </div>

                            <div class="mt-auto d-grid gap-2">
                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.ProductID"
                                   class="btn btn-dark">
                                    View Product
                                </a>

                                @if (firstVariant != null)
                                {
                                    <form asp-controller="Cart" asp-action="Add" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productVariantId" value="@firstVariant.ProductVariantId" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-outline-dark w-100">
                                            Add To Cart
                                        </button>
                                    </form>
                                }

                                <form asp-controller="Wishlist" asp-action="Remove" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.ProductID" />
                                    <button type="submit" class="btn btn-outline-danger w-100">
                                        Remove
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>