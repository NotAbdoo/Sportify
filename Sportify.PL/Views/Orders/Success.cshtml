@model Order
@{
    ViewData["Title"] = "Order Confirmed - Sportify";
}

<style>
    .success-page {
        background: #f8f8f8;
        min-height: 100vh;
        display: flex;
        align-items: center;
        padding: 60px 0;
    }

    .success-card {
        background: #fff;
        border-radius: 32px;
        padding: 50px;
        box-shadow: 0 15px 50px rgba(0,0,0,.03);
        border: 1px solid #eee;
        text-align: center;
        max-width: 650px;
        margin: auto;
    }

    .success-icon-wrapper {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: #e8f9ef;
        color: #198754;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 30px;
    }

    .success-title {
        font-size: 36px;
        font-weight: 800;
        color: #111;
        margin-bottom: 15px;
    }

    .order-number {
        background: #f8f8f8;
        padding: 12px 24px;
        border-radius: 12px;
        font-weight: 700;
        color: #CC0000;
        display: inline-block;
        margin-top: 10px;
        font-size: 18px;
    }

    .success-btn {
        background: #CC0000;
        color: #fff;
        border: none;
        padding: 16px 40px;
        border-radius: 16px;
        font-weight: 700;
        transition: .3s ease;
        text-decoration: none;
        display: inline-block;
        margin-top: 30px;
    }

    .success-btn:hover {
        background: #2a1e5c;
        color: #fff;
    }

    .secondary-btn {
        border: 2px solid #111;
        background: transparent;
        color: #111;
        padding: 14px 40px;
        border-radius: 16px;
        font-weight: 700;
        transition: .3s ease;
        text-decoration: none;
        display: inline-block;
        margin-top: 30px;
        margin-left: 10px;
    }

    .secondary-btn:hover {
        background: #111;
        color: #fff;
    }
</style>

<section class="success-page">
    <div class="container">
        <div class="success-card">
            
            <div class="success-icon-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>

            <h1 class="success-title">Thank You For Your Order!</h1>
            <p class="text-muted fs-5">Your order has been placed successfully and is currently being processed by our store.</p>
            
            <div>
                <span class="order-number">
                    <h4>
                        Order ID: #SP@(Model.OrderId.ToString("D4"))
                    </h4>
                </span>
            </div>

            <p class="text-muted mt-4">We sent a confirmation email to @Context.Session.GetString("UserEmail"). You can track the progress of your shipment in your account dashboard.</p>

            <div class="d-flex justify-content-center">
                <a asp-controller="Orders" asp-action="Index" class="success-btn">My Orders</a>
                <a asp-controller="Products" asp-action="Index" class="secondary-btn">Continue Shopping</a>
            </div>

        </div>
    </div>
</section>
